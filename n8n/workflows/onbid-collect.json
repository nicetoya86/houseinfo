{
  "name": "onbid-collect",
  "__comment": "Design Ref: §11.1 module-4 — 온비드 부동산 물건목록 수집 → Supabase upsert → ISR revalidate. 실제 온비드 응답 필드는 data.go.kr 활용신청(로그인) 후 확인 필요 — 아래 Normalize Fields 노드의 TODO 매핑을 실제 필드명으로 교체할 것.",
  "active": false,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Daily Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 3 * * *" }]
        }
      }
    },
    {
      "id": "fetch-onbid",
      "name": "Fetch Onbid Properties",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [250, 0],
      "parameters": {
        "method": "GET",
        "url": "https://apis.data.go.kr/B190001/openapi/service/OwOnBidReqRtmUseSttusService/getUnifyUsageCompasRealEstateInfoDtl",
        "__comment": "TODO: data.go.kr 활용신청 후 확인한 실제 엔드포인트로 교체",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "serviceKey", "value": "={{ $env.ONBID_API_KEY }}" },
            { "name": "prptDivCd", "value": "0001" },
            { "name": "pvctTrgtYn", "value": "N" },
            { "name": "numOfRows", "value": "100" },
            { "name": "pageNo", "value": "1" },
            { "name": "_type", "value": "json" }
          ]
        }
      }
    },
    {
      "id": "normalize-fields",
      "name": "Normalize Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 0],
      "parameters": {
        "jsCode": "// TODO: 아래 필드 매핑은 placeholder. data.go.kr 활용신청 후 실제 응답 필드명으로 교체 필요.\n// Design Ref: §3.3 properties 테이블 컬럼에 맞춰 변환.\nconst items = $input.first().json.response?.body?.items ?? [];\nreturn items.map((item) => ({\n  json: {\n    case_number: item.pbancNo ?? item.cltrNo, // TODO: 실제 공고/물건 관리번호 필드로 교체\n    type: 'public_sale',\n    category: item.prptDivNm ?? 'etc', // TODO: 코드→카테고리 매핑 테이블 필요\n    sido: item.ldnmAdrs?.split(' ')?.[0] ?? '',\n    sigungu: item.ldnmAdrs?.split(' ')?.[1] ?? '',\n    eupmyeondong: item.ldnmAdrs?.split(' ')?.[2] ?? null,\n    address: item.ldnmAdrs ?? '',\n    appraisal_value: Number(item.aprsAmt ?? 0), // TODO: 실제 감정가 필드명 확인\n    min_bid: Number(item.minBidPrc ?? 0), // TODO: 실제 최저입찰가 필드명 확인\n    fail_count: Number(item.pbctCnt ?? 0) - 1, // TODO: 유찰횟수 산정 로직 확인\n    sale_date: item.pbctCltrmDt ?? null, // TODO: 개찰(매각)일 필드명 확인\n    zone_type: item.lndUseSittn ?? null,\n    status: 'active',\n    images: [],\n  },\n}));"
      }
    },
    {
      "id": "supabase-upsert",
      "name": "Upsert to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/properties?on_conflict=case_number",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Prefer", "value": "resolution=merge-duplicates" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    },
    {
      "id": "call-revalidate",
      "name": "Call Revalidate Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_APP_URL }}/api/revalidate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-revalidate-secret", "value": "={{ $env.ISR_REVALIDATE_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { propertyId: $json.id } }}"
      }
    },
    {
      "id": "call-viewing-guide-webhook",
      "name": "Trigger Viewing Guide Generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/viewing-guide/generate",
        "__comment": "viewing-guide-generate.json 워크플로우 연동 — 신규 매물마다 임장 가이드 비동기 생성 트리거",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { propertyId: $('Upsert to Supabase').item.json.id, address: $('Upsert to Supabase').item.json.address, category: $('Upsert to Supabase').item.json.category, appraisalValue: $('Upsert to Supabase').item.json.appraisal_value } }}"
      }
    }
  ],
  "connections": {
    "Daily Cron": { "main": [[{ "node": "Fetch Onbid Properties", "type": "main", "index": 0 }]] },
    "Fetch Onbid Properties": { "main": [[{ "node": "Normalize Fields", "type": "main", "index": 0 }]] },
    "Normalize Fields": { "main": [[{ "node": "Upsert to Supabase", "type": "main", "index": 0 }]] },
    "Upsert to Supabase": {
      "main": [
        [
          { "node": "Call Revalidate Webhook", "type": "main", "index": 0 },
          { "node": "Trigger Viewing Guide Generation", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
